// Схема базы данных H&CR.
//
// Читается почти как наши Zod-схемы: объявляем поля и типы. Разница в том,
// что Zod проверяет данные на лету, а это описание превращается в настоящие
// таблицы Postgres командой `prisma migrate dev`.
//
// Здесь ТОЛЬКО то, что мы храним сами. Уровни и игроки приходят из Global
// Demonlist и в базе не дублируются — иначе копии разъедутся с оригиналом.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Новости сайта. Заменяет массив-заглушку в src/lib/news.ts
model News {
  // UUIDv7: начинается с метки времени, поэтому новые записи ложатся
  // в конец индекса, а не втыкаются в середину, как это делает UUIDv4.
  id       String   @id @default(uuid(7))
  title    String
  category String   @default("Новость")
  /// Дата, которая показывается посетителю. Может отличаться от createdAt:
  /// новость можно написать заранее и поставить нужную дату.
  date     DateTime @default(now())
  text     String
  /// Путь к картинке, например /news1.png. Пусто — новость без картинки.
  image    String?

  /// Черновики не показываются на сайте. Позволяет писать заранее.
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Индекс под главный запрос сайта: «опубликованные, свежие сверху»
  @@index([published, date])
}

/// Стримы и прогрессы. Заменяет заглушку в src/lib/streams.ts
model Stream {
  id            String  @id @default(uuid(7))
  playerName    String
  /// Название страны как в Global Demonlist: 'United-States', 'Unknown'.
  /// Тот же формат, что у игроков, — чтобы работал общий countryCode().
  playerCountry String  @default("Unknown")
  levelName     String
  /// Процент прохождения, 0–100
  progress      Int     @default(0)
  isLive        Boolean @default(false)
  url           String

  /// Ручной порядок: позволяет закрепить важный стрим сверху
  sortOrder Int @default(0)

  /* ---- Автоматическое отслеживание эфира ---- */

  /// Ник на Twitch. Если задан, статус эфира обновляется сам.
  twitchLogin String?

  /// id канала на YouTube — вид UCxxxxxxxxxxxxxxxxxxxxxx.
  ///
  /// Указывается один раз, как и ник Twitch. Раз в N минут по нему ищется
  /// живой эфир. Поиск дорогой (100 единиц квоты из 10 000 в сутки),
  /// поэтому частота считается от числа каналов — см. youtube.ts.
  youtubeChannelId String?

  /// id найденной трансляции — 11 символов.
  ///
  /// Заполняется САМ, когда поиск обнаружил эфир на канале. Пока он тут
  /// есть, статус проверяется по нему: это стоит 1 единицу вместо 100.
  /// Когда эфир кончился — очищается, и всё возвращается к поиску.
  ///
  /// Можно задать и вручную: тогда следим за конкретной трансляцией.
  youtubeVideoId String?

  /// Когда последний раз ИСКАЛИ эфир на канале.
  ///
  /// Отдельно от lastCheckedAt: проверка видео дешёвая и частая,
  /// поиск по каналу дорогой и редкий. Мешать их в одно поле нельзя —
  /// иначе частые дешёвые проверки будут сбрасывать счётчик дорогих.
  lastSearchAt DateTime?

  /// Название трансляции, каким его отдала площадка при последней проверке.
  /// Из него предлагается процент — но не применяется сам.
  streamTitle String?

  /// Когда последний раз спрашивали площадку
  lastCheckedAt DateTime?

  /// Личный ключ стримера.
  ///
  /// По ссылке /update/{ключ} игрок меняет свой процент без входа и пароля.
  /// Процент знает только он: ни Twitch, ни YouTube эту цифру не отдают,
  /// а из названия трансляции она вытаскивается лишь угадыванием.
  ///
  /// Значение генерирует САМА БАЗА, а не Prisma. Причина практическая:
  /// prisma-level default не превращается в DEFAULT в SQL, и добавить
  /// такую колонку в непустую таблицу невозможно — Postgres нечего
  /// записать в уже существующие строки.
  ///
  /// Заодно вышло правильнее по смыслу: gen_random_uuid() даёт полностью
  /// случайное значение, а uuid(7) начинается с метки времени. Для ключа
  /// доступа время создания знать посторонним незачем.
  updateToken String @unique @default(dbgenerated("gen_random_uuid()"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLive, sortOrder])
}

/// Статус заявки на рекорд.
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Заявка на рекорд, присланная посетителем сайта.
///
/// ОТДЕЛЬНАЯ таблица, а не поле в Stream — намеренно.
///
/// Здесь лежит то, что написали посторонние люди: ники, названия, ссылки.
/// Данные, которые показываются на сайте, лежат в Stream. Пока модератор
/// не одобрит заявку, ничего из неё на сайт не попадёт — и это гарантируется
/// не проверкой в запросе, которую можно забыть, а тем, что публичные
/// страницы в эту таблицу вообще не смотрят.
model Submission {
  id String @id @default(uuid(7))

  playerName String
  /// Страна в формате Global Demonlist: 'United-States', 'Unknown'
  playerCountry String @default("Unknown")
  levelName     String
  /// Процент прохождения, 0–100
  progress  Int
  videoUrl  String
  /// Что человек хочет добавить от себя
  comment String?
  /// Как с ним связаться: Telegram, Discord, почта. Необязательно
  contact String?

  status SubmissionStatus @default(PENDING)

  /// ХЕШ адреса отправителя, а не сам адрес.
  ///
  /// Нужен только для ограничения частоты: «не больше N заявок в час
  /// с одного адреса». Хранить сам IP не надо — это персональные данные,
  /// а для нашей задачи достаточно уметь сравнить «тот же или другой».
  ipHash String

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  /// Почта модератора, который решил судьбу заявки
  reviewedBy String?

  // Под главный запрос админки: «новые заявки, свежие сверху»
  @@index([status, createdAt])
  // Под проверку частоты отправки
  @@index([ipHash, createdAt])
}

/// Собственный рейтинг H&CR — вторая вкладка на странице уровней.
///
/// Храним только id уровня и свою позицию. Название, автора, превью и видео
/// возьмём из API по этому id. Дублировать их тут нельзя: уровень могут
/// переименовать, и у нас останется устаревшая копия.
model CommunityRank {
  /// id уровня в Global Demonlist. Он же первичный ключ:
  /// один уровень не может стоять в списке дважды.
  levelId Int @id

  /// Наша позиция в списке. Не уникальная нарочно — иначе при перестановке
  /// двух уровней местами база ругнётся посреди операции.
  position Int

  /// Требуемый процент прохождения по нашей версии
  requirement Int @default(100)

  /// Комментарий редакции: почему уровень стоит именно здесь
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
